# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Show the demo-account quick login box and the dev reset link on "forgot password".
# Set to "false" before putting this anywhere real.
DEMO_MODE="true"

# ---- Production only (set in the server's .env) ----
# Keeps Server Action ids stable across deploys: `openssl rand -base64 32`, set once, never change.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Passwords used by `prisma/seed.ts` for the demo accounts when seeding production.
# SEED_ADMIN_PASSWORD=
# SEED_REP_PASSWORD=
# SEED_STUDENT_PASSWORD=
# SEED_DEFAULT_PASSWORD=
